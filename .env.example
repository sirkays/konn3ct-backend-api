APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=database
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Admin Auth JWT & Cookie Configuration
ADMIN_JWT_ACCESS_SECRET=
ADMIN_JWT_REFRESH_SECRET=
ADMIN_JWT_ISSUER=konn3ct-api
ADMIN_JWT_AUDIENCE=konn3ct-admin
ADMIN_ACCESS_TOKEN_TTL=900
ADMIN_REFRESH_TOKEN_TTL=604800
ADMIN_REFRESH_COOKIE_NAME=konn3ct_admin_refresh_token
ADMIN_REFRESH_COOKIE_SECURE=false
ADMIN_REFRESH_COOKIE_SAME_SITE=lax
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_DECAY_SECONDS=900

# Odoo 19 Integration
ODOO19_INTEGRATION_ENABLED=false
ODOO19_BASE_URL=
ODOO19_USER_REGISTERED_PATH=
ODOO19_USAGE_METRICS_PATH=
ODOO19_PAYMENT_SUCCESS_PATH=
ODOO19_PAYMENT_FAILED_PATH=
ODOO19_PAID_EVENT_PURCHASE_PATH=
ODOO19_API_TOKEN=
ODOO19_SIGNING_SECRET=
ODOO19_QUEUE_CONNECTION=database
ODOO19_QUEUE_NAME=odoo
ODOO19_CONNECT_TIMEOUT_SECONDS=5
ODOO19_REQUEST_TIMEOUT_SECONDS=15
ODOO19_MAX_ATTEMPTS=5
ODOO19_BACKOFF_SECONDS=60,300,900,3600,21600
ODOO19_USAGE_METRICS_ENABLED=false
ODOO19_USAGE_METRICS_TIME=01:00
