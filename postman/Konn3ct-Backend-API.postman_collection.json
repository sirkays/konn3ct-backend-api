                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "url": "{{base_url}}/api/v1/admin/auth/login",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "response": [],
              "event": [
                {
                  "id": "f3906ee3-41a7-4360-8f12-87790996251f",
                  "listen": "test",
                  "script": {
                    "id": "47275f47-3b89-4ba7-aacd-b30b88d7c2c2",
                    "exec": [
                      "pm.test('Status code is 200', function () {",
                      "    pm.response.to.have.status(200);",
                      "});",
                      "var json = pm.response.json();",
                      "if (json.data && json.data.access_token) {",
                      "    pm.collectionVariables.set('admin_access_token', json.data.access_token);",
                      "}"
                    ],
                    "type": "text/javascript"
                  }
                }
              ]
            },
